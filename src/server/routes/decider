const { getCoordinates } = require('../services/geoService');
const Activity = require('../models/Activity');

router.post('/add-activity', async (req, res) => {
    const geoData = await getCoordinates(req.body.address);
    
    const newActivity = new Activity({
        name: req.body.name,
        address: geoData.fullAddress,
        location: {
            type: 'Point',
            coordinates: geoData.coordinates // Mapbox returns [lng, lat]
        }
    });

    await newActivity.save();
    res.send("Activity Saved!");
});