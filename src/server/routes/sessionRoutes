const express = require('express');
const router = express.Router();
const { createSession, joinSession, getSession, startSession } = require('../controllers/sessionController');

router.post('/create', createSession);
router.post('/join', joinSession);
router.put('/start/:pin', startSession);
router.get('/:pin', getSession);

router.get('/:pin/movies', async (req, res) => {
    try {

        const url = 'https://api.themoviedb.org/3/discover/movie'
            + '?api_key=' + process.env.TMDB_API_KEY
            + '&language=en-US'
            + '&region=US'
            + '&sort_by=popularity.desc'
            + '&vote_count.gte=5000'
            + '&vote_average.gte=7'
            + '&page=3'
            + '&with_original_language=en';

        const response = await fetch(url);
        const data = await response.json();

        res.json(data);

    } catch (error) {
        console.error('Error fetching from TMDB:', error);
        res.status(500).json({ error: 'Failed to fetch movies' });
    }
});


router.get('/:pin/food', async (req, res) => {
    try {

        // Get lat/lng from the query string
        // e.g. /api/session/1234/food?lat=40.7128&lng=-74.0060
        const { lat, lng } = req.query;

        if (!lat || !lng) {
            return res.status(400).json({ error: 'Missing lat/lng — make sure location is enabled' });
        }

        const url = 'https://api.yelp.com/v3/businesses/search'
                  + '?latitude=' + lat
                  + '&longitude=' + lng
                  + '&categories=restaurants'
                  + '&sort_by=rating'
                  + '&limit=10';

        const response = await fetch(url, {
            headers: {
                'Authorization': 'Bearer ' + process.env.YELP_API_KEY
            }
        });

        const data = await response.json();
        res.json(data);

    } catch (error) {
        console.error('Error fetching from Yelp:', error);
        res.status(500).json({ error: 'Failed to fetch restaurants' });
    }
});

module.exports = router;